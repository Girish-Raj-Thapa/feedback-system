# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# The public URL of this app. Used for widget script snippets and install verification.
# Local dev:   http://localhost:3000
# Production:  https://www.feedbackflow.app
# NEXT_PUBLIC_APP_URL=

# Phase C: Background Jobs & Emails
# EMAIL_DELIVERY_METHOD=inline # Use 'queue' to route through BullMQ, or 'inline' for serverless after()
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=54325
# SMTP_USER=
# SMTP_PASS=
# REDIS_URL=redis://localhost:6379 # Used for BullMQ worker (if EMAIL_DELIVERY_METHOD=queue)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379 # Used for distributed rate limiting (Upstash serverless compatible)
# RESEND_API_KEY=

# Usage limits
FREE_TIER_LIMIT=50

# Spam Protection / Cloudflare Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA