# ===========================================================================
# Feedback System - Example Environment Configuration (.env.example)
# Copy this file to .env and configure values for your environment.
# ===========================================================================

# ---------------------------------------------------------------------------
# Core Application & Routing
# ---------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=console
FRONTEND_URL=http://localhost:3000
PUBLIC_FEEDBACK_URL=http://localhost:3000/f
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 via asyncpg)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/feedback_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis (Taskiq Broker & Session/Permission Cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Authentication & Cryptographic Security
# In production: generate a 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
WORKSPACE_INVITE_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ---------------------------------------------------------------------------
# Email / Transactional SMTP Delivery
# In local dev: points to Mailpit / Mailhog or local SMTP.
# In production: configure your transactional provider (Resend, SendGrid, Postmark, SES).
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@feedbacksystem.com
EMAILS_FROM_NAME=Feedback System

# ---------------------------------------------------------------------------
# AI & LLM Service Configuration
# LLM_PROVIDER: "gemini" | "openai" | "mock"
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# ---------------------------------------------------------------------------
# Rate Limiting & Abuse Prevention
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Billing & Subscriptions (Stripe / Paddle)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

